@page "{id}"
@model AgentBattle.Web.Pages.Battles.ReplayModel
@{
  ViewData["Title"] = $"Battle {Model.BattleId}";
  ViewData["BodyClass"] = "is-replay-page";
}

<div x-data="replay('@Model.BattleId')" x-init="load()" class="replay">

  <header class="replay-header">
    <h1>Battle <code>@Model.BattleId</code></h1>
    <div class="replay-toggles">
      <label><input type="checkbox" x-model="godView" />God view</label>
      <label><input type="checkbox" x-model="showStrengths" />Hand strengths</label>
      <label><input type="checkbox" x-model="sound" />Sound</label>
    </div>
  </header>

  <section class="poker-table" x-show="loaded">
    <div class="felt"></div>

    <div class="battle-result-overlay" x-show="battleResult" x-transition.opacity>
      <div class="battle-result-card">
        <div class="battle-result-header">🏆 Battle complete</div>
        <ol class="battle-result-list">
          <template x-for="(r, i) in (battleResult?.ranking ?? [])" :key="r.seat ?? r.name">
            <li :class="{ 'is-winner': i === 0 }">
              <span class="battle-result-pos" x-text="i + 1"></span>
              <span class="battle-result-name" x-text="r.name"></span>
              <span class="battle-result-chips" x-text="r.chips + ' chips'"></span>
            </li>
          </template>
        </ol>
      </div>
    </div>

    <div class="action-toast"
         :class="{ 'is-visible': toast.visible }"
         :data-kind="toast.kind"
         x-show="toast.visible"
         x-transition.opacity>
      <span class="toast-icon" x-text="toast.icon"></span>
      <span x-text="toast.who"></span>
      <span x-text="toast.text"></span>
      <span class="toast-amount" x-show="toast.amount" x-text="toast.amount"></span>
    </div>

    <div class="community">
      <div class="community-cards">
        <template x-for="(card, i) in community" :key="card + '-' + i">
          <span class="card community-card"
                :data-suit="card[1]"
                x-transition:enter="card-enter"
                x-transition:enter-start="card-enter-start"
                x-transition:enter-end="card-enter-end">
            <span class="card-corner top-left">
              <span class="card-rank" x-text="displayRank(card[0])"></span>
              <span class="card-suit" x-text="suitSymbol(card[1])"></span>
            </span>
            <span class="card-center" x-text="suitSymbol(card[1])"></span>
            <span class="card-corner bottom-right">
              <span class="card-rank" x-text="displayRank(card[0])"></span>
              <span class="card-suit" x-text="suitSymbol(card[1])"></span>
            </span>
          </span>
        </template>
      </div>
      <div class="pot" :class="{ 'is-bumping': potBumping }">Pot: <span x-text="pot"></span></div>
    </div>

    <div class="hand-result" x-show="handResult" x-transition.opacity>
      <span class="hand-result-no">Hand <span x-text="handResult?.handNo"></span></span>
      <template x-for="w in (handResult?.winners ?? [])" :key="w.seat">
        <span class="hand-result-winner">
          <strong x-text="w.name"></strong>
          <template x-if="w.handDesc"><span x-text="'· ' + w.handDesc"></span></template>
          <span class="hand-result-pot" x-text="'+' + w.pot"></span>
        </span>
      </template>
    </div>

    <div class="seats" :data-count="seats.length">
      <template x-for="(seat, idx) in seats" :key="seat.seat">
        <div class="seat"
             :data-seat-pos="idx"
             :class="{
               'is-current': seat.seat === currentSeat,
               'is-folded': seat.hasFolded,
               'is-acting': seat.seat === flashSeat,
               'is-winning': winnerSeats.includes(seat.seat)
             }">
          <template x-if="positionTag(seat.seat)">
            <span class="seat-tag" :data-kind="positionTag(seat.seat)" x-text="positionTag(seat.seat).toUpperCase()"></span>
          </template>
          <div class="name" x-text="seat.displayName"></div>
          <div class="stack">
            Stack: <span x-text="seat.stack"></span>
            <template x-if="seat.delta">
              <span class="stack-delta" :class="seat.delta > 0 ? 'is-up' : 'is-down'"
                    x-text="(seat.delta > 0 ? '+' : '') + seat.delta"></span>
            </template>
          </div>
          <div class="cards">
            <template x-for="(card, i) in cardsForSeat(seat.seat)" :key="i">
              <span class="card hole-card"
                    :data-back="card === '??'"
                    :data-suit="card[1]">
                <template x-if="card !== '??'">
                  <span class="card-inner">
                    <span class="card-corner top-left">
                      <span class="card-rank" x-text="displayRank(card[0])"></span>
                      <span class="card-suit" x-text="suitSymbol(card[1])"></span>
                    </span>
                    <span class="card-center" x-text="suitSymbol(card[1])"></span>
                    <span class="card-corner bottom-right">
                      <span class="card-rank" x-text="displayRank(card[0])"></span>
                      <span class="card-suit" x-text="suitSymbol(card[1])"></span>
                    </span>
                  </span>
                </template>
              </span>
            </template>
          </div>
          <div class="bet" x-show="seat.currentBet > 0">Bet: <span x-text="seat.currentBet"></span></div>
          <div class="seat-strength"
               x-show="showStrengths && strengthFor(seat.seat)"
               :class="{ 'is-leader': strengthFor(seat.seat)?.isLeader }"
               x-text="strengthFor(seat.seat)?.label"></div>
        </div>
      </template>
    </div>
  </section>

  <section class="controls" x-show="loaded">
    <button @@click="prev()" title="Previous">&#x276E;</button>
    <button class="btn-play" @@click="togglePlay()" x-text="playing ? '⏸ Pause' : '▶ Play'"></button>
    <button @@click="next()" title="Next">&#x276F;</button>
    <label>
      Speed
      <select x-model.number="speed">
        <option value="0.5">0.5×</option>
        <option value="1">1×</option>
        <option value="2">2×</option>
        <option value="4">4×</option>
        <option value="8">8×</option>
      </select>
    </label>
    <input type="range" min="0" :max="Math.max(0, events.length - 1)" x-model.number="idx" @@input="rebuild(true)" />
    <span class="event-label" x-text="describeCurrent()"></span>
  </section>

  <aside class="thoughts-panel" x-show="loaded">
    <div class="thoughts-head">
      <h2>Reasoning stream</h2>
      <span class="focus-name" x-text="currentSeatName() || '—'"></span>
    </div>
    <div class="thoughts-body" x-ref="thoughtsBody">
      <div class="thoughts-stream">
        <template x-for="t in thoughtsStream" :key="t.id">
          <div class="thought-item" :class="{ 'is-active': t.seat === currentSeat }">
            <div class="thought-meta">
              <span class="thought-author" x-text="t.author"></span>
              <span>hand <span x-text="t.handNo"></span> · <span x-text="t.street"></span></span>
            </div>
            <p class="thought-text" :class="{ 'is-empty': !t.text }" x-text="t.text || '(model returned no reasoning text)'"></p>
            <div class="thought-action" x-show="t.action">
              <span x-text="t.action?.label"></span>
              <span :class="'act-' + t.action?.kind" x-text="t.action?.verb"></span>
              <span x-show="t.action?.amount" class="act-amt" x-text="'→ ' + t.action?.amount"></span>
            </div>
          </div>
        </template>
        <div class="suggestions-empty" x-show="thoughtsStream.length === 0">
          No reasoning yet — scrub forward or hit play.
        </div>
      </div>
    </div>
    <div class="strengths-panel" x-show="showStrengths">
      <h3>Hand rankings</h3>
      <ol class="strengths-list">
        <template x-for="(s, idx) in rankedStrengths" :key="s.seat">
          <li :class="{ 'strengths-leader': idx === 0 && rankedStrengths.length > 1 && !s.folded, 'strengths-folded': s.folded }">
            <span class="strengths-pos" x-text="idx + 1"></span>
            <span class="strengths-name" x-text="s.displayName"></span>
            <span class="strengths-cat" x-text="s.categoryName"></span>
          </li>
        </template>
        <li x-show="rankedStrengths.length === 0" class="strengths-empty">No visible hands yet.</li>
      </ol>
    </div>
  </aside>
</div>

<script src="~/lib/alpine.min.js" defer></script>
<script src="~/js/hand-eval.js"></script>
<script src="~/js/sfx.js"></script>
<script src="~/js/replay.js"></script>
