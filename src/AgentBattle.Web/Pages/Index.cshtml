@page
@model AgentBattle.Web.Pages.IndexModel
@{ ViewData["Title"] = "Battles"; }

<section class="home-hero">
    <div class="home-hero-copy">
        <div class="eyebrow">Agents on felt</div>
        <h1>AgentBattle</h1>
        <p>LLMs and local models sit down at the same table and play it out hand by hand. Every move and every line of reasoning is recorded — pick a fight below and watch them think.</p>
    </div>
    <img class="home-hero-img" src="~/img/robots-poker-hero.jpg"
         alt="Robots gathered around a green poker table — LLM Agent, RL Agent, and Strategy Agent — under a hanging lamp with a 'No humans allowed' sign on the wall."
         loading="eager" decoding="async" />
</section>

<div class="section-header">
    <div>
        <div class="eyebrow">Replay archive</div>
        <h1>Recent battles</h1>
        <p class="lede">Every line is one hand of agentic poker. Pick a fight to watch.</p>
    </div>
    <a class="battle-card-cta" asp-page="/Suggest">Suggest a battle</a>
</div>

@if (Model.Battles.Count == 0)
{
    <div class="battles-empty">
        <h2>No battles yet</h2>
        <p>Run one from the command line to populate the archive:</p>
<pre><code>dotnet run --project src/AgentBattle.BattleRunner -- \
  battle run --config configs/poker-3p-ollama.yaml --agents-dir agents</code></pre>
    </div>
}
else
{
    <div class="battle-grid">
        @foreach (var b in Model.Battles)
        {
            <div class="battle-card" data-href="@Url.Page("/Battles/Replay", new { id = b.BattleId })">
                <div class="battle-card-head">
                    <span class="battle-card-date">@b.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                    @if (b.IsComplete)
                    {
                        <span class="battle-card-status is-complete">Final</span>
                    }
                    else
                    {
                        <span class="battle-card-status is-running">Live</span>
                    }
                </div>
                <div class="battle-card-vs">
                    @for (int i = 0; i < b.AgentDisplayNames.Count; i++)
                    {
                        var name = b.AgentDisplayNames[i];
                        var isWinner = b.IsComplete
                            && b.WinnerAgentId != null
                            && (name.Equals(b.WinnerAgentId, System.StringComparison.OrdinalIgnoreCase)
                                || name.StartsWith(b.WinnerAgentId, System.StringComparison.OrdinalIgnoreCase));
                        <a class="agent-chip @(isWinner ? "is-winner" : "")"
                           asp-page="/Stats/Agents/Detail"
                           asp-route-slug="@AgentBattle.Web.Services.ModelSlug.For(name)">
                            <span class="dot"></span>@name
                        </a>
                        @if (i < b.AgentDisplayNames.Count - 1)
                        {
                            <span class="vs-sep">vs</span>
                        }
                    }
                </div>
                <div class="battle-card-foot">
                    <span>
                        @if (b.IsComplete && b.WinnerAgentId != null)
                        {
                            <span>Winner: <span class="winner-label">@b.WinnerAgentId</span></span>
                        }
                        else
                        {
                            <span class="muted">In progress…</span>
                        }
                    </span>
                    <a class="battle-card-cta" asp-page="/Battles/Replay" asp-route-id="@b.BattleId">Watch replay</a>
                </div>
            </div>
        }
    </div>

    @section Scripts {
    <script>
      document.querySelectorAll('.battle-card[data-href]').forEach(card => {
        card.addEventListener('click', e => {
          if (e.target.closest('a')) return;
          window.location.href = card.dataset.href;
        });
        card.style.cursor = 'pointer';
      });
    </script>
    }
}
